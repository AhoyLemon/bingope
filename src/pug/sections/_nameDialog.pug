dialog.name-dialog(
  ref="nameDialog"
  aria-labelledby="NameDialogTitle"
  @click="onNameDialogBackdropClick"
)
  form.name-dialog__form(method="dialog" @submit="submitNameChange")
    h2#NameDialogTitle Change your ticket
    p.name-dialog__note Renaming keeps your card and your marks. A new card deals you a fresh one for a fresh day.
    label(for="DisplayName") What should your ticket say?
    input#DisplayName(
      type="text"
      name="displayName"
      autocomplete="name"
      required
      autofocus
      v-model="nameDraft"
    )
    .name-dialog__actions
      button.name-dialog__cancel(type="button" @click="closeNameDialog") Never mind
      button.name-dialog__deal(type="button" @click="dealNewCard") New card
      button.name-dialog__save(type="submit") Rename
