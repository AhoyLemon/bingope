- const pageTitle = "Minnesota State Fair Bingo"
- const assetPath = ""
include partials/_variables
include partials/_mixins

doctype html
html(lang="en")
  include partials/_head.pug

  body.entry-page
    main#app.entry-app
      .entry-content
        header.entry-header
          .entry-wordmark(aria-label="BINGOPE" role="img")
            include ../svg/bingope_v2.svg
          p.entry-tagline Minnesota State Fair Bingo, by Lemon

      .entry-photo-band(aria-hidden="true")
        img.entry-photo(src=assetPath + "img/entry-crowd.png" alt="" role="presentation")

      .entry-content
        //- On a special day (see ts/partials/_specialDays.ts), Vue asks the
        //- opt-in question first; a day with a fixed roster (Lemon Day) then
        //- offers a picker straight to the bespoke card. Both blocks default
        //- to an inline `display:none`, understood without JS, so a no-JS
        //- visit falls straight through to the plain form below on every
        //- day, exactly as it always has. Vue overrides `display` once it
        //- mounts via `:style`, which merges with a static `style` rather
        //- than conflicting with it — unlike a plain attribute, so this
        //- (never `v-if`/`template`) keeps the fallback markup genuinely
        //- present in the static HTML instead of living inside JS-only
        //- template blocks.
        div.entry-special-day(
          style="display:none"
          v-bind:style="{ display: specialDay && specialDayOptIn === null ? 'block' : 'none' }"
        )
          p {{ specialDay ? `Are you part of ${specialDay.label}?` : '' }}
          .button-holder
            button(type="button" v-on:click="answerSpecialDay(true)") Yes
            button(type="button" v-on:click="answerSpecialDay(false)") No

        div.entry-special-day(
          style="display:none"
          v-bind:style="{ display: specialDay && specialDayOptIn && specialDay.bespokeSlugs ? 'block' : 'none' }"
        )
          p Which one are you?
          .button-holder
            a.button(v-for="slug in (specialDay && specialDay.bespokeSlugs) || []" :key="slug" :href="`card/?card=${slug}`") {{ bespokeName(slug) }}

        //- The native GET action is the no-JS fallback. _nameEntry.ts normalizes
        //- the typed name before navigation; see ts/partials/_nameEntry.ts. A
        //- "yes" answer on a special day with no fixed roster (Blank Metal Day)
        //- is carried here via data-special-group, since _nameEntry.ts is plain
        //- JS with no view into this Vue state.
        form.name-entry(
          action="card/"
          method="get"
          v-bind:style="{ display: (specialDay && specialDayOptIn === null) || (specialDay && specialDayOptIn && specialDay.bespokeSlugs) ? 'none' : undefined }"
          v-bind:data-special-group="specialDayOptIn && specialDay && !specialDay.bespokeSlugs ? specialDay.name : null"
        )
          label(for="CardName") What's your name?
          input#CardName(type="text" name="card" required autocomplete="name" v-model="name.input")

          .button-holder(v-if="name.input")
            button(type="submit") Get My Card

        p.entry-help
          a(href="help/") What is this?

      img.entry-corner-accent(src=assetPath + "svg/entry-corner-accent.svg" alt="" role="presentation" aria-hidden="true")

    include partials/_javascripts
    include partials/_schema
